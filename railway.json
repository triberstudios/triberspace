{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx turbo build --filter=@triberspace/api"
  },
  "deploy": {
    "startCommand": "npm run start --workspace=@triberspace/api",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
