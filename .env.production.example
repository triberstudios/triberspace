# Triberspace Production Environment Variables Template
# Copy this file and fill in your production values
# DO NOT commit actual production values to git

# =============================================================================
# DATABASE
# =============================================================================
# Get this from Neon dashboard (use pooled connection)
DATABASE_URL="postgresql://neondb_owner:npg_4HK0DxLYXyzu@ep-muddy-sun-a4hy9ibm-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# =============================================================================
# AUTHENTICATION (Better Auth)
# =============================================================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-character-secret-here

# Your backend API URL
BETTER_AUTH_URL=https://api.triber.space

# =============================================================================
# FRONTEND URLS
# =============================================================================
FRONTEND_URL=https://triber.space
NEXT_PUBLIC_FRONTEND_URL=https://triber.space
NEXT_PUBLIC_API_URL=https://api.triber.space

# =============================================================================
# MULTIPLAYER (PartyKit)
# =============================================================================
# Your PartyKit deployment URL (without https://)
NEXT_PUBLIC_PARTYKIT_HOST=triberspace.partykit.dev

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3001

# =============================================================================
# CLOUDFLARE R2 (S3-Compatible Storage)
# =============================================================================
# Get these from Cloudflare R2 dashboard
S3_ENDPOINT=https://67ae98914ca76492247d67677e96c4e0.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=triberspace
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Your R2 public domain for CDN access
CDN_BASE_URL=https://cdn.triber.space

# =============================================================================
# GOOGLE OAUTH (Optional)
# =============================================================================
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# OPENAI (Optional - for AI features in engine)
# =============================================================================
OPENAI_SECRET_KEY=sk-your-openai-api-key

# =============================================================================
# DEPLOYMENT PLATFORM SPECIFIC
# =============================================================================

# Railway - Set these in Railway dashboard
# - All variables above should be set in Railway Variables section

# Cloudflare Pages - Set these in Pages Environment Variables
# - NEXT_PUBLIC_API_URL
# - NEXT_PUBLIC_PARTYKIT_HOST
# - NEXT_PUBLIC_FRONTEND_URL
# - NODE_ENV

# PartyKit - Add to partykit.json vars section
# - API_URL
# - BETTER_AUTH_SECRET

# =============================================================================
# NOTES
# =============================================================================
# 1. BETTER_AUTH_SECRET must be the same across all services
# 2. Use pooled connection for DATABASE_URL (from Neon dashboard)
# 3. NEXT_PUBLIC_* variables are exposed to the browser (non-sensitive only)
# 4. Update CORS origins in backend/api/src/server.ts for production domains
# 5. Update Better Auth trusted origins in packages/auth/src/index.ts
